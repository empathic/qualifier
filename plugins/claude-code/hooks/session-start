#!/usr/bin/env bash
# SessionStart hook for the qual plugin. In a project that contains .qual
# files, inject how to call qualifier, a short thread summary, and the
# using-qualifier skill. Silent everywhere else. Never fails the session:
# every path exits 0.

set -uo pipefail

PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
PROJECT_DIR="${CLAUDE_PROJECT_DIR:-$PWD}"
WRAPPER="$PLUGIN_ROOT/scripts/ensure-qualifier.sh"

# The project root: the nearest ancestor with a VCS marker (as qualifier
# finds it), else the project directory itself.
find_root() {
    local dir="$1" marker
    while [ -n "$dir" ] && [ "$dir" != "/" ]; do
        for marker in .git .hg .jj .pijul _FOSSIL_ .svn; do
            if [ -e "$dir/$marker" ]; then
                echo "$dir"
                return 0
            fi
        done
        dir="$(dirname "$dir")"
    done
    return 1
}

# Any .qual file under the root? Git work trees answer from the index
# (tracked plus untracked, not ignored); elsewhere a depth-limited find.
# Output is captured rather than piped into `grep -q`: with pipefail, the
# producer's SIGPIPE after `head` exits would read as "no match".
has_qual_files() {
    local hit
    if git -C "$1" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        hit="$(git -C "$1" ls-files --cached --others --exclude-standard -- '*.qual' 2>/dev/null | head -n 1)"
    else
        hit="$(find "$1" -maxdepth 6 \
            \( -name .git -o -name .hg -o -name .jj -o -name .pijul -o -name .svn \
               -o -name node_modules -o -name target \) -prune \
            -o \( -name .qual -o -name '*.qual' \) -type f -print 2>/dev/null | head -n 1)"
    fi
    [ -n "$hit" ]
}

# `threads --summary` with a wall-clock budget of SUMMARY_BUDGET seconds;
# prints nothing if it isn't done in time.
#
# A watchdog (one `sleep`, so load delays only that one exec) kills the
# summary when the budget runs out, while this shell blocks in `wait`, which
# returns as soon as the summary exits: a quick summary returns at once, a
# slow one after the budget. $SECONDS is not used: it is whole seconds only.
#
# Monitor mode (set -m) is on only while the two jobs start: it puts each in
# its own process group, so the watchdog's kill reaches everything the
# summary started, not only the direct child, and killing the watchdog's
# group also stops its `sleep`. Groups are assigned at fork, and neither
# `wait` nor `kill -- -pgid` needs monitor mode, so it goes off right after.
# Left on, it would also run each later foreground command (the `cat`
# below) in a group of its own and hand it the terminal, briefly
# backgrounding this shell; a hook killed then leaves the terminal with a
# dead foreground group. The kill is SIGKILL, so nothing can ignore it and
# `wait` cannot hang. Both jobs have stdout redirected away from the command
# substitution, which would otherwise wait for them to close it.
SUMMARY_BUDGET=2
bounded_summary() {
    local out pid watchdog
    out="$(mktemp)" || return 0
    set -m
    (cd "$ROOT" && exec "$1" threads --summary) </dev/null >"$out" 2>/dev/null &
    pid=$!
    (sleep "$SUMMARY_BUDGET"; kill -KILL -- -"$pid") </dev/null >/dev/null 2>&1 &
    watchdog=$!
    set +m
    if wait "$pid" 2>/dev/null; then
        cat "$out"
    fi
    kill -KILL -- -"$watchdog" 2>/dev/null
    wait "$watchdog" 2>/dev/null
    rm -f "$out"
}

# Strips C0 control characters other than \t \n \r (a raw ESC or form feed
# from a wrapped tool's output would otherwise land unescaped in the JSON
# string below and make the whole additionalContext unparseable), then
# escapes what JSON requires.
escape_for_json() {
    local s="$1"
    s="$(printf '%s' "$s" | LC_ALL=C tr -d '\000-\010\013\014\016-\037')"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

ROOT="$(find_root "$PROJECT_DIR")" || ROOT="$PROJECT_DIR"
has_qual_files "$ROOT" || exit 0

# The skill body with its frontmatter stripped: the block between the first
# and second `---` lines. A file with no frontmatter (first line isn't
# `---`) is passed through whole.
skill_body="$(awk '
    NR == 1 && $0 != "---" { no_frontmatter = 1 }
    no_frontmatter { print; next }
    n >= 2 { print; next }
    /^---$/ { n++ }
' "$PLUGIN_ROOT/skills/using-qualifier/SKILL.md" 2>/dev/null)"

BIN="$("$WRAPPER" 2>/dev/null)" || BIN=""
pinned_version="$("$WRAPPER" pinned-version 2>/dev/null || true)"

# The manual route: the wrapper never looks on PATH, so a cargo-installed
# qualifier is used only once QUALIFIER_BIN names it.
cargo_bin="${CARGO_HOME:-${HOME:-~}/.cargo}/bin/qualifier"
manual_install="Ask the user to run \`cargo install qualifier${pinned_version:+ --version $pinned_version} --locked\`, then set QUALIFIER_BIN to the installed binary's absolute path (\`${cargo_bin}\` by default) in their shell profile or under \`env\` in Claude Code settings, and start a new session. A qualifier on PATH is not used."

summary=""
if [ -z "$BIN" ] && ! "$WRAPPER" prebuilt-target >/dev/null 2>&1; then
    call_line="There is no prebuilt qualifier binary for this platform, so the plugin cannot install its pinned release. ${manual_install}"
elif [ -z "$BIN" ]; then
    call_line="The plugin could not install its pinned qualifier release here (download or checksum failed; it retries next session). If that persists (e.g. no network access to GitHub releases): ${manual_install}"
else
    call_line="Run qualifier as \`\"$WRAPPER\" exec <args>\` (pre-approved in every qual skill); the qual skills write \`qualifier\` for short. A \`qualifier\` on your PATH, if any, is not used and may be a different version."
    summary="$(bounded_summary "$BIN")"
fi

# Assembled so a missing summary contributes no blank line.
body_lines=("This repository uses qualifier (.qual files found). ${call_line}")
[ -n "$summary" ] && body_lines+=("$summary")

context="<qualifier-plugin>
$(printf '%s\n' "${body_lines[@]}")
${skill_body}
</qualifier-plugin>"

printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' \
    "$(escape_for_json "$context")"
exit 0
